// Phase 1: first real models — Shopify shop installation and OAuth CSRF
// state. Phase 2 adds the product data foundation (Product, Variant,
// ProductImage). The rest of the data model (landing_pages,
// landing_page_versions, templates, analytics_events, ...) is introduced
// starting Phase 3 of the roadmap.

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopStatus {
  INSTALLED
  UNINSTALLED
}

// One row per Shopify shop that has ever installed the app. Rows are never
// deleted on uninstall (auditability / future data-retention decisions) —
// uninstall instead flips `status`, stamps `uninstalledAt`, and nulls out
// `accessTokenCiphertext` so the offline token can no longer be used even
// if application-level status checks were ever bypassed.
model Shop {
  id                    String     @id @default(uuid())
  shopDomain            String     @unique
  // AES-256-GCM ciphertext blob (see server/src/modules/shopify/security/tokenCipher.ts).
  // Null once uninstalled, or before the OAuth callback has ever completed.
  accessTokenCiphertext String?
  // Space-separated scopes actually granted by Shopify for the current token.
  scopes                String?
  status                ShopStatus @default(INSTALLED)
  installedAt           DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  uninstalledAt         DateTime?

  products Product[]

  @@index([status])
}

// Phase 2: application-owned mirror of a Shopify product, scoped to exactly
// one Shop (the multi-tenant boundary — every query is filtered by shopId,
// never trusted from client input). `shopifyProductId` is stored as
// Shopify's GID string (e.g. "gid://shopify/Product/123") so rows created
// via GraphQL sync and via REST webhook payloads (which carry a numeric id,
// normalized to the same GID shape before persistence) always match the
// same unique key. `deletedAt` is a soft-delete marker (mirrors Shop's
// `uninstalledAt` pattern) set when Shopify reports the product removed —
// rows are kept, not deleted, so a future landing page can still reference
// one. `status` mirrors Shopify's own ACTIVE/ARCHIVED/DRAFT product status
// and is unrelated to `deletedAt`.
model Product {
  id               String        @id @default(uuid())
  shopId           String
  shop             Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyProductId String
  title            String
  handle           String
  description      String?
  vendor           String?
  productType      String?
  status           ProductStatus
  lastSyncedAt     DateTime      @default(now())
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants Variant[]
  images   ProductImage[]

  @@unique([shopId, shopifyProductId])
  @@index([shopId])
  @@index([shopId, deletedAt])
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

// One row per Shopify product variant. Upserted (not delete-and-recreate)
// keyed by (productId, shopifyVariantId) so a variant's internal id stays
// stable across repeated syncs. `price`/`compareAtPrice` are stored as
// Decimal (exact, not floating point) — Shopify's GraphQL Money scalar and
// REST price fields are both decimal strings, parsed directly.
// `selectedOptions` is the variant's option name/value pairs (e.g. Size:
// Large), needed for display since Phase 2 has no separate option-schema
// model.
model Variant {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyVariantId  String
  title             String
  sku               String?
  price             Decimal  @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  inventoryQuantity Int?
  selectedOptions   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, shopifyVariantId])
  @@index([productId])
}

// Deliberately minimal — Phase 2 needs only enough to render a thumbnail
// and pick a featured image (the image at `position` 0, ascending) for
// future landing-page selection. No asset-management system (uploads,
// transformations, CDN variants) is built here.
model ProductImage {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyImageId String
  url            String
  altText        String?
  position       Int
  createdAt      DateTime @default(now())

  @@unique([productId, shopifyImageId])
  @@index([productId])
}

// Short-lived, single-use OAuth CSRF state. A row is created when the
// install flow redirects to Shopify and deleted the moment it is consumed
// (successfully or not) by the callback, so a state value can never be
// replayed.
model OAuthState {
  id         String   @id @default(uuid())
  state      String   @unique
  shopDomain String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
