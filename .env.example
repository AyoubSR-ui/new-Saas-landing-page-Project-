# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_landing_saas

# Shopify app credentials (from the Partner Dashboard). SHOPIFY_API_KEY is the
# public client ID; SHOPIFY_API_SECRET is a secret and must never reach the
# client or logs. SHOPIFY_APP_URL is this app's public base URL (no trailing
# slash) — the OAuth redirect URI is derived from it.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_products

# 32 random bytes, base64-encoded — used for AES-256-GCM encryption of
# Shopify offline access tokens at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Client (Vite, exposed to the browser bundle — public values only, never a
# secret). Must match SHOPIFY_API_KEY above.
VITE_SHOPIFY_API_KEY=

# AI (Phase 6)
AI_PROVIDER_API_KEY=
